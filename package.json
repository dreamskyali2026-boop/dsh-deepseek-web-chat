{
  "name": "@local/dsh-deepseek-web-chat",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "author": "Dream",
  "description": "A dedicated DeepSeek Web Chat window for the DeepSeek Harness desktop app.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
